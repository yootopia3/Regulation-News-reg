SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon-jwt>
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt>
GEMINI_API_KEY=<gemini-api-key>
GEMINI_ENABLED=false
TELEGRAM_BOT_TOKEN=<optional>
TELEGRAM_CHAT_ID=<optional>
ENV_TYPE=development

# --- Web dashboard / Vercel ---
NEXT_PUBLIC_USE_V2_DB=true
NEXT_PUBLIC_SUPABASE_URL_V2=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY_V2=<anon-jwt>
APP_PASSCODE=<dashboard-passcode>
SESSION_SECRET=<long-random-session-secret>
GITHUB_TOKEN=<github-token-with-actions-write-and-read-access>
GITHUB_REPOSITORY=<your-github-owner>/<your-repo-name>

# --- Gemini models (override defaults; optional) ---
GEMINI_FILTER_MODEL=gemini-2.5-flash-lite
GEMINI_ANALYZER_MODEL=gemini-3-flash-preview
GEMINI_ANALYZER_FALLBACK_MODEL=gemini-1.5-pro
